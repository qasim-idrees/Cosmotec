                                tabindex="-1">
                                <?= $productImage->toHtml() ?>
                            </a>
                        </div>
                        <div class="product-item-stock-delivery">
                            <?=/* @noEscape */ $_product->getAttributeText('ct_when_out_of_stock'); ?>
                        </div>
