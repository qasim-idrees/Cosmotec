                            <?= $escaper->escapeHtml(__('Model: ')) ?><?=/* @noEscape */ $_helper->productAttribute($_product, $_product->getCtModel(), 'ct_model')?>
                            <?php // $block->getReviewsSummaryHtml($_product, $templateType) ?>
                        </div>
                        
                    
                    </div>
                    <div class="product-item-actions">
                         
                                    <div class="product-item-price">
                                        <?= /* @noEscape */ $block->getProductPrice($_product) ?>
                                    </div>
                                
                                        <?php if ($_product->isSaleable()):?>
                                            <button type="button" title="<?php echo  $block->escapeHtmlAttr(__('Add to Cart')); ?>" class="action tocart" 
