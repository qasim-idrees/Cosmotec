<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Cosmotec_EccubeMigration::config"
                                      title="EC-CUBE Migration Section"
                                      translate="title"
                                      sortOrder="500"/>
                        </resource>
                    </resource>
                </resource>
                <resource id="Cosmotec_EccubeMigration::migration"
                          title="EC-CUBE Migration"
                          translate="title"
                          sortOrder="500">
                    <resource id="Cosmotec_EccubeMigration::dashboard"
                              title="Dashboard"
                              translate="title"
                              sortOrder="10"/>
                    <resource id="Cosmotec_EccubeMigration::mapping"
                              title="Entity Mapping"
                              translate="title"
                              sortOrder="20"/>
                    <resource id="Cosmotec_EccubeMigration::sync_history"
                              title="Synchronization History"
                              translate="title"
                              sortOrder="30"/>
                    <resource id="Cosmotec_EccubeMigration::logs"
                              title="Logs"
                              translate="title"
                              sortOrder="40"/>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
