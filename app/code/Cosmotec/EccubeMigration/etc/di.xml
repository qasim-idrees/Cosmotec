                <item name="cosmotecEccubeSyncItemAttributeValues" xsi:type="object">Cosmotec\EccubeMigration\Console\Command\SyncItemAttributeValuesCommand</item>
                <item name="cosmotecEccubeSyncProductAttributeValues" xsi:type="object">Cosmotec\EccubeMigration\Console\Command\SyncProductAttributeValuesCommand</item>
