                <item name="cosmotecEccubeImportItemAttributeValues" xsi:type="object">Cosmotec\EccubeMigration\Console\Command\ImportItemAttributeValuesCommand</item>
                <item name="cosmotecEccubeImportProductAttributeValues" xsi:type="object">Cosmotec\EccubeMigration\Console\Command\ImportProductAttributeValuesCommand</item>
