<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="cosmotec_eccube_full_import"
             instance="Cosmotec\EccubeMigration\Cron\FullImportCron"
             method="execute">
            <schedule>0 2 * * *</schedule>
        </job>
        <job name="cosmotec_eccube_sync"
             instance="Cosmotec\EccubeMigration\Cron\SyncCron"
             method="execute">
            <schedule>0 * * * *</schedule>
        </job>
    </group>
</config>
