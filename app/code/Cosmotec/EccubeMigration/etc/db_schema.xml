<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="eccube_category_map" resource="default" engine="innodb"
           comment="Maps EC-CUBE dtb_category rows to Magento catalog categories">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="eccube_category_id" unsigned="true" nullable="false" comment="dtb_category.id"/>
        <column xsi:type="int" name="magento_category_id" unsigned="true" nullable="true" comment="catalog_category_entity.entity_id"/>
        <column xsi:type="varchar" name="content_hash" nullable="true" length="64" comment="Hash of mapped source fields, used to skip unchanged records on sync"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="pending" comment="pending|imported|updated|skipped|error"/>
        <column xsi:type="text" name="error_message" nullable="true" comment="Last error message, if status=error"/>
        <column xsi:type="timestamp" name="last_synced_at" nullable="true" comment="Last successful import/sync timestamp"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ECCUBE_CATEGORY_MAP_ECCUBE_CATEGORY_ID">
            <column name="eccube_category_id"/>
        </constraint>
        <index referenceId="ECCUBE_CATEGORY_MAP_MAGENTO_CATEGORY_ID" indexType="btree">
            <column name="magento_category_id"/>
        </index>
        <index referenceId="ECCUBE_CATEGORY_MAP_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>

    <table name="eccube_item_map" resource="default" engine="innodb"
           comment="Maps EC-CUBE dtb_item rows to Magento Grouped Products">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="eccube_item_id" unsigned="true" nullable="false" comment="dtb_item.id"/>
        <column xsi:type="int" name="magento_product_id" unsigned="true" nullable="true" comment="catalog_product_entity.entity_id"/>
        <column xsi:type="varchar" name="sku" nullable="true" length="128" comment="Synthesized SKU assigned to the Grouped Product"/>
        <column xsi:type="varchar" name="content_hash" nullable="true" length="64" comment="Hash of mapped source fields, used to skip unchanged records on sync"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="pending" comment="pending|imported|updated|skipped|error"/>
        <column xsi:type="varchar" name="specification_value_hash" nullable="true" length="64" comment="Hash of last-applied ITEM-scope specification attribute values, used to skip unchanged EAV writes - same pattern as inventory_content_hash on eccube_product_map"/>
        <column xsi:type="timestamp" name="specification_values_synced_at" nullable="true" comment="Last successful specification-value import/sync timestamp"/>
        <column xsi:type="text" name="error_message" nullable="true" comment="Last error message, if status=error"/>
        <column xsi:type="timestamp" name="last_synced_at" nullable="true" comment="Last successful import/sync timestamp"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ECCUBE_ITEM_MAP_ECCUBE_ITEM_ID">
            <column name="eccube_item_id"/>
        </constraint>
        <index referenceId="ECCUBE_ITEM_MAP_MAGENTO_PRODUCT_ID" indexType="btree">
            <column name="magento_product_id"/>
        </index>
        <index referenceId="ECCUBE_ITEM_MAP_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>

    <table name="eccube_product_map" resource="default" engine="innodb"
           comment="Maps EC-CUBE dtb_product rows to Magento Simple Products">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="eccube_product_id" unsigned="true" nullable="false" comment="dtb_product.id"/>
        <column xsi:type="int" name="eccube_item_id" unsigned="true" nullable="true" comment="dtb_product.item_id, denormalized here so ProductRelationImporter does not need a second EC-CUBE round trip"/>
        <column xsi:type="int" name="magento_product_id" unsigned="true" nullable="true" comment="catalog_product_entity.entity_id"/>
        <column xsi:type="varchar" name="sku" nullable="true" length="128" comment="SKU assigned to the Simple Product"/>
        <column xsi:type="varchar" name="content_hash" nullable="true" length="64" comment="Hash of mapped source fields, used to skip unchanged records on sync"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="pending" comment="pending|imported|updated|skipped|error"/>
        <column xsi:type="smallint" name="relation_linked" unsigned="true" nullable="false" default="0" comment="1 once this product has been linked to its parent Grouped Product, 0 otherwise"/>
        <column xsi:type="varchar" name="inventory_content_hash" nullable="true" length="64" comment="Hash of last-applied inventory data, used to skip unchanged MSI writes"/>
        <column xsi:type="timestamp" name="inventory_synced_at" nullable="true" comment="Last successful inventory import/sync timestamp"/>
        <column xsi:type="varchar" name="specification_value_hash" nullable="true" length="64" comment="Hash of last-applied PRODUCT-scope specification attribute values, used to skip unchanged EAV writes"/>
        <column xsi:type="timestamp" name="specification_values_synced_at" nullable="true" comment="Last successful specification-value import/sync timestamp"/>
        <column xsi:type="text" name="error_message" nullable="true" comment="Last error message, if status=error"/>
        <column xsi:type="timestamp" name="last_synced_at" nullable="true" comment="Last successful import/sync timestamp"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ECCUBE_PRODUCT_MAP_ECCUBE_PRODUCT_ID">
            <column name="eccube_product_id"/>
        </constraint>
        <index referenceId="ECCUBE_PRODUCT_MAP_MAGENTO_PRODUCT_ID" indexType="btree">
            <column name="magento_product_id"/>
        </index>
        <index referenceId="ECCUBE_PRODUCT_MAP_STATUS" indexType="btree">
            <column name="status"/>
        </index>
        <index referenceId="ECCUBE_PRODUCT_MAP_ITEM_ID_RELATION_LINKED" indexType="btree">
            <column name="eccube_item_id"/>
            <column name="relation_linked"/>
        </index>
    </table>

    <table name="eccube_image_map" resource="default" engine="innodb"
           comment="Maps EC-CUBE dtb_product_image rows to Magento product media gallery entries">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="eccube_image_id" unsigned="true" nullable="false" comment="dtb_product_image.id"/>
        <column xsi:type="int" name="eccube_product_id" unsigned="true" nullable="false" comment="dtb_product_image.product_id"/>
        <column xsi:type="int" name="magento_product_id" unsigned="true" nullable="true" comment="catalog_product_entity.entity_id the image belongs to"/>
        <column xsi:type="int" name="gallery_value_id" unsigned="true" nullable="true" comment="Media gallery entry id returned by ProductAttributeMediaGalleryManagementInterface::create()"/>
        <column xsi:type="varchar" name="file_name" nullable="true" length="255" comment="dtb_product_image.file_name at last successful import"/>
        <column xsi:type="varchar" name="content_hash" nullable="true" length="64" comment="Hash of filename+filesize+mtime, used for changed-image detection"/>
        <column xsi:type="smallint" name="is_main" unsigned="true" nullable="false" default="0" comment="1 if this image holds the image/small_image/thumbnail roles, 0 if gallery-only"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="pending" comment="pending|imported|updated|skipped|error"/>
        <column xsi:type="text" name="error_message" nullable="true" comment="Last error message, if status=error"/>
        <column xsi:type="timestamp" name="last_synced_at" nullable="true" comment="Last successful import/sync timestamp"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ECCUBE_IMAGE_MAP_ECCUBE_IMAGE_ID">
            <column name="eccube_image_id"/>
        </constraint>
        <index referenceId="ECCUBE_IMAGE_MAP_PRODUCT_ID" indexType="btree">
            <column name="eccube_product_id"/>
        </index>
        <index referenceId="ECCUBE_IMAGE_MAP_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>

    <table name="eccube_specification_map" resource="default" engine="innodb"
           comment="Maps EC-CUBE dtb_specification rows to Magento product EAV attributes">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="eccube_specification_id" unsigned="true" nullable="false" comment="dtb_specification.id"/>
        <column xsi:type="varchar" name="attribute_code" nullable="false" length="64" comment="Deterministic Magento attribute code eccube_spec_{id}"/>
        <column xsi:type="int" name="magento_attribute_id" unsigned="true" nullable="true" comment="eav_attribute.attribute_id once created"/>
        <column xsi:type="varchar" name="label_en" nullable="true" length="255" comment="English label used (English-first policy)"/>
        <column xsi:type="varchar" name="label_ja" nullable="true" length="255" comment="Japanese label retained for reference"/>
        <column xsi:type="smallint" name="used_at_item_scope" unsigned="true" nullable="false" default="0" comment="1 if any dtb_item_specification.type=1 references it (Grouped Product scope)"/>
        <column xsi:type="smallint" name="used_at_product_scope" unsigned="true" nullable="false" default="0" comment="1 if any dtb_item_specification.type=2 references it (Simple Product scope)"/>
        <column xsi:type="int" name="selectable_count" unsigned="true" nullable="false" default="0" comment="Source per-item selectable count; preserved for future exact-fidelity filtering"/>
        <column xsi:type="smallint" name="is_filterable" unsigned="true" nullable="false" default="0" comment="Magento is_filterable applied (UNION rule)"/>
        <column xsi:type="int" name="option_count" unsigned="true" nullable="false" default="0" comment="dtb_specification_class count"/>
        <column xsi:type="int" name="sort_no" nullable="false" default="0" comment="dtb_specification.sort_no - source ordering, never alphabetical"/>
        <column xsi:type="varchar" name="classification" nullable="false" length="32" default="NEEDS_REVIEW" comment="CREATE|SKIP_UNUSED|SKIP_INVALID|NEEDS_REVIEW"/>
        <column xsi:type="text" name="classification_reason" nullable="true" comment="Why a specification was skipped - never empty for a skip"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="pending" comment="pending|imported|updated|skipped|error"/>
        <column xsi:type="text" name="error_message" nullable="true" comment="Last error"/>
        <column xsi:type="timestamp" name="last_synced_at" nullable="true" comment="Last successful sync"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ECCUBE_SPECIFICATION_MAP_SPEC_ID">
            <column name="eccube_specification_id"/>
        </constraint>
        <index referenceId="ECCUBE_SPECIFICATION_MAP_ATTRIBUTE_CODE" indexType="btree">
            <column name="attribute_code"/>
        </index>
        <index referenceId="ECCUBE_SPECIFICATION_MAP_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>

    <table name="eccube_specification_option_map" resource="default" engine="innodb"
           comment="Maps EC-CUBE dtb_specification_class rows to Magento attribute options">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="eccube_specification_class_id" unsigned="true" nullable="false" comment="dtb_specification_class.id"/>
        <column xsi:type="int" name="eccube_specification_id" unsigned="true" nullable="false" comment="Owning dtb_specification.id"/>
        <column xsi:type="varchar" name="attribute_code" nullable="false" length="64" comment="Owning Magento attribute code"/>
        <column xsi:type="int" name="magento_option_id" unsigned="true" nullable="true" comment="eav_attribute_option.option_id once created"/>
        <column xsi:type="varchar" name="label_en" nullable="true" length="255" comment="English option label"/>
        <column xsi:type="varchar" name="label_ja" nullable="true" length="255" comment="Japanese option label retained"/>
        <column xsi:type="int" name="sort_no" nullable="false" default="0" comment="dtb_specification_class.sort_no - source ordering preserved"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="pending" comment="pending|imported|updated|skipped|error"/>
        <column xsi:type="text" name="error_message" nullable="true" comment="Last error"/>
        <column xsi:type="timestamp" name="last_synced_at" nullable="true" comment="Last successful sync"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ECCUBE_SPEC_OPTION_MAP_CLASS_ID">
            <column name="eccube_specification_class_id"/>
        </constraint>
        <index referenceId="ECCUBE_SPEC_OPTION_MAP_SPEC_ID" indexType="btree">
            <column name="eccube_specification_id"/>
        </index>
        <index referenceId="ECCUBE_SPEC_OPTION_MAP_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>

    <table name="eccube_media_map" resource="default" engine="innodb"
           comment="Maps EC-CUBE dtb_upload_file relations to Magento media/documents. Relation-aware: replaces the obsolete dtb_product_image based mapping.">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="eccube_upload_file_id" unsigned="true" nullable="false" comment="dtb_upload_file.id - canonical source file identity"/>
        <column xsi:type="varchar" name="relation_type" nullable="false" length="24" comment="product|dimension|cad2d|cad3d|item|catalog|category"/>
        <column xsi:type="int" name="eccube_owner_id" unsigned="true" nullable="false" comment="Owning dtb_product / dtb_item / dtb_category id"/>
        <column xsi:type="int" name="sort_no" nullable="false" default="0" comment="Source ordering within the owner"/>
        <column xsi:type="varchar" name="source_file_name" nullable="false" length="255" comment="dtb_upload_file.file_name"/>
        <column xsi:type="varchar" name="file_extension" nullable="true" length="16" comment="Lowercased extension"/>
        <column xsi:type="varchar" name="media_class" nullable="false" length="16" default="OTHER" comment="IMAGE|DOCUMENT|CAD|ARCHIVE|OTHER"/>
        <column xsi:type="varchar" name="magento_entity_type" nullable="true" length="24" comment="simple_product|grouped_product|category"/>
        <column xsi:type="int" name="magento_entity_id" unsigned="true" nullable="true" comment="Resolved Magento entity id"/>
        <column xsi:type="varchar" name="magento_file_path" nullable="true" length="512" comment="Final Magento media path"/>
        <column xsi:type="varchar" name="magento_role" nullable="true" length="64" comment="image,small_image,thumbnail | dimension_drawing | cad2d | cad3d | catalog"/>
        <column xsi:type="varchar" name="content_hash" nullable="true" length="80" comment="filename+size+mtime hash for change detection - prefixed sha256:/meta: + 64 hex chars, needs more than 64"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="pending" comment="pending|imported|updated|skipped|error|needs_review|obsolete"/>
        <column xsi:type="text" name="error_message" nullable="true" comment="Non-empty whenever status is skipped or error"/>
        <column xsi:type="timestamp" name="last_synced_at" nullable="true" comment="Last successful sync"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ECCUBE_MEDIA_MAP_RELATION_OWNER_FILE">
            <column name="relation_type"/>
            <column name="eccube_owner_id"/>
            <column name="eccube_upload_file_id"/>
        </constraint>
        <index referenceId="ECCUBE_MEDIA_MAP_UPLOAD_FILE_ID" indexType="btree">
            <column name="eccube_upload_file_id"/>
        </index>
        <index referenceId="ECCUBE_MEDIA_MAP_RELATION_TYPE" indexType="btree">
            <column name="relation_type"/>
        </index>
        <index referenceId="ECCUBE_MEDIA_MAP_STATUS" indexType="btree">
            <column name="status"/>
        </index>
        <index referenceId="ECCUBE_MEDIA_MAP_OWNER" indexType="btree">
            <column name="relation_type"/>
            <column name="eccube_owner_id"/>
        </index>
    </table>

    <table name="eccube_product_reference_map" resource="default" engine="innodb"
           comment="Maps EC-CUBE dtb_product_reference (1:N document name/link) to Magento. Deliberately NOT flattened into numbered EAV attributes.">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="eccube_reference_id" unsigned="true" nullable="false" comment="dtb_product_reference.id"/>
        <column xsi:type="int" name="eccube_product_id" unsigned="true" nullable="false" comment="dtb_product_reference.product_id"/>
        <column xsi:type="int" name="magento_product_id" unsigned="true" nullable="true" comment="Resolved Magento simple product id"/>
        <column xsi:type="varchar" name="reference_name" nullable="true" length="64" comment="dtb_product_reference.name (document name)"/>
        <column xsi:type="varchar" name="reference_link" nullable="true" length="512" comment="dtb_product_reference.link"/>
        <column xsi:type="int" name="sort_no" nullable="false" default="0" comment="Derived ordering (source has no sort column; source id order is used)"/>
        <column xsi:type="varchar" name="content_hash" nullable="true" length="64" comment="Hash of name+link for change detection"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="pending" comment="pending|imported|updated|skipped|error|obsolete"/>
        <column xsi:type="text" name="error_message" nullable="true" comment="Last error"/>
        <column xsi:type="timestamp" name="last_synced_at" nullable="true" comment="Last successful sync"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ECCUBE_PRODUCT_REFERENCE_MAP_SOURCE_ID">
            <column name="eccube_reference_id"/>
        </constraint>
        <index referenceId="ECCUBE_PRODUCT_REFERENCE_MAP_PRODUCT" indexType="btree">
            <column name="eccube_product_id"/>
        </index>
        <index referenceId="ECCUBE_PRODUCT_REFERENCE_MAP_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>

    <table name="eccube_attribute_set_map" resource="default" engine="innodb"
           comment="Maps EC-CUBE top-level dtb_category rows to Magento catalog_product Attribute Sets. Magento design decision - EC-CUBE has no attribute-set concept.">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="eccube_top_level_category_id" unsigned="true" nullable="false" comment="dtb_category.id, hierarchy=1 row this set was derived from"/>
        <column xsi:type="varchar" name="set_name" nullable="false" length="255" comment="Proposed/assigned Magento attribute_set_name (English top-level category name)"/>
        <column xsi:type="int" name="magento_attribute_set_id" unsigned="true" nullable="true" comment="eav_attribute_set.attribute_set_id once created"/>
        <column xsi:type="int" name="specification_count" unsigned="true" nullable="false" default="0" comment="Number of specifications assigned (union of the category tree's usage)"/>
        <column xsi:type="varchar" name="content_hash" nullable="true" length="64" comment="Hash of the assigned specification-id set, used to detect when the union needs re-syncing"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="pending" comment="pending|imported|updated|skipped|error"/>
        <column xsi:type="text" name="error_message" nullable="true" comment="Last error message, if status=error"/>
        <column xsi:type="timestamp" name="last_synced_at" nullable="true" comment="Last successful import/sync timestamp"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ECCUBE_ATTRIBUTE_SET_MAP_CATEGORY_ID">
            <column name="eccube_top_level_category_id"/>
        </constraint>
        <index referenceId="ECCUBE_ATTRIBUTE_SET_MAP_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>

    <table name="eccube_product_specification_value" resource="default" engine="innodb"
           comment="PENDING DESIGN (see BUILD_STATUS.md): lossless positional storage for the 5 specifications (ICF/NW-KF/VF/VG/D) confirmed to carry more than one real value per product (329 pairs). Not approved for creation until the business decision is confirmed - see MultiValueSpecificationRegistry.">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="eccube_product_specification_class_id" unsigned="true" nullable="false" comment="dtb_product_specification_class.id - the exact source row, so re-runs are exact-match idempotent"/>
        <column xsi:type="int" name="eccube_product_id" unsigned="true" nullable="false" comment="dtb_product_specification_class.product_id"/>
        <column xsi:type="int" name="eccube_specification_id" unsigned="true" nullable="false" comment="Resolved via dtb_specification_class.specification_id"/>
        <column xsi:type="int" name="eccube_specification_class_id" unsigned="true" nullable="false" comment="dtb_specification_class.id - the chosen option"/>
        <column xsi:type="int" name="magento_option_id" unsigned="true" nullable="true" comment="Resolved Magento eav_attribute_option.option_id"/>
        <column xsi:type="smallint" name="position" unsigned="true" nullable="false" default="0" comment="0-based position among this product's values for this specification. dtb_product_specification_class has no source ordering column (verified live) - this is row-id insertion order, the same deterministic fallback already used for eccube_product_reference_map"/>
        <column xsi:type="int" name="magento_product_id" unsigned="true" nullable="true" comment="Resolved Magento simple product id"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="pending" comment="pending|imported|updated|skipped|error"/>
        <column xsi:type="text" name="error_message" nullable="true" comment="Last error message, if status=error"/>
        <column xsi:type="timestamp" name="last_synced_at" nullable="true" comment="Last successful import/sync timestamp"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ECCUBE_PRODUCT_SPEC_VALUE_SOURCE_ID">
            <column name="eccube_product_specification_class_id"/>
        </constraint>
        <index referenceId="ECCUBE_PRODUCT_SPEC_VALUE_PRODUCT_SPEC" indexType="btree">
            <column name="eccube_product_id"/>
            <column name="eccube_specification_id"/>
        </index>
    </table>

    <table name="eccube_coupling_product_map" resource="default" engine="innodb"
           comment="Maps EC-CUBE dtb_coupling_product (Item -&gt; specific Product, &quot;Connection Parts&quot;) to Magento. Deliberately NOT Magento's built-in related/upsell/cross-sell link types - semantically distinct, per docs/MIGRATION_ASSUMPTIONS.md §3.">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="eccube_coupling_id" unsigned="true" nullable="false" comment="dtb_coupling_product.id"/>
        <column xsi:type="int" name="eccube_item_id" unsigned="true" nullable="false" comment="dtb_coupling_product.item_id - the parent Item"/>
        <column xsi:type="int" name="eccube_product_id" unsigned="true" nullable="false" comment="dtb_coupling_product.product_id - the connected child Product"/>
        <column xsi:type="int" name="magento_parent_product_id" unsigned="true" nullable="true" comment="Resolved Magento Grouped Product id"/>
        <column xsi:type="int" name="magento_connected_product_id" unsigned="true" nullable="true" comment="Resolved Magento Simple Product id"/>
        <column xsi:type="int" name="sort_no" nullable="false" default="0" comment="Derived ordering (source has no sort column; source id order is used, same fallback as eccube_product_reference_map)"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="pending" comment="pending|imported|updated|skipped|error|obsolete"/>
        <column xsi:type="text" name="error_message" nullable="true" comment="Last error message, if status=error"/>
        <column xsi:type="timestamp" name="last_synced_at" nullable="true" comment="Last successful import/sync timestamp"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ECCUBE_COUPLING_PRODUCT_MAP_SOURCE_ID">
            <column name="eccube_coupling_id"/>
        </constraint>
        <index referenceId="ECCUBE_COUPLING_PRODUCT_MAP_ITEM_ID" indexType="btree">
            <column name="eccube_item_id"/>
        </index>
    </table>

    <table name="eccube_related_product_map" resource="default" engine="innodb"
           comment="Maps EC-CUBE dtb_related_product (Product -&gt; Product, child-level) to Magento native related-product links. Structurally distinct from eccube_coupling_product_map - must not share a Magento link type.">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="eccube_related_id" unsigned="true" nullable="false" comment="dtb_related_product.id"/>
        <column xsi:type="int" name="eccube_product_id" unsigned="true" nullable="false" comment="dtb_related_product.product_id - the source child Product"/>
        <column xsi:type="int" name="eccube_related_product_id" unsigned="true" nullable="false" comment="dtb_related_product.related_product_id - the target child Product"/>
        <column xsi:type="int" name="magento_product_id" unsigned="true" nullable="true" comment="Resolved Magento Simple Product id (source)"/>
        <column xsi:type="int" name="magento_related_product_id" unsigned="true" nullable="true" comment="Resolved Magento Simple Product id (target)"/>
        <column xsi:type="int" name="sort_no" nullable="false" default="0" comment="Derived ordering (source has no sort column; source id order is used)"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="pending" comment="pending|imported|updated|skipped|error|obsolete"/>
        <column xsi:type="text" name="error_message" nullable="true" comment="Last error message, if status=error"/>
        <column xsi:type="timestamp" name="last_synced_at" nullable="true" comment="Last successful import/sync timestamp"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ECCUBE_RELATED_PRODUCT_MAP_SOURCE_ID">
            <column name="eccube_related_id"/>
        </constraint>
        <index referenceId="ECCUBE_RELATED_PRODUCT_MAP_PRODUCT_ID" indexType="btree">
            <column name="eccube_product_id"/>
        </index>
    </table>

    <table name="eccube_sync_history" resource="default" engine="innodb"
           comment="Append-only log of every import/sync operation across all entity types">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="run_id" nullable="false" length="64" comment="Groups all rows produced by one CLI invocation"/>
        <column xsi:type="varchar" name="entity_type" nullable="false" length="32" comment="category|item|product|product_class|image|inventory"/>
        <column xsi:type="varchar" name="operation" nullable="false" length="16" comment="import|sync"/>
        <column xsi:type="int" name="source_id" unsigned="true" nullable="false" comment="EC-CUBE side primary key"/>
        <column xsi:type="int" name="target_id" unsigned="true" nullable="true" comment="Magento side entity id, if created/updated"/>
        <column xsi:type="varchar" name="status" nullable="false" length="16" comment="imported|updated|skipped|error"/>
        <column xsi:type="text" name="message" nullable="true" comment="Human-readable outcome or error detail"/>
        <column xsi:type="int" name="duration_ms" unsigned="true" nullable="true" comment="Processing duration for this record, in milliseconds"/>
        <column xsi:type="bigint" name="memory_bytes" unsigned="true" nullable="true" comment="memory_get_usage() at time of processing"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="ECCUBE_SYNC_HISTORY_RUN_ID" indexType="btree">
            <column name="run_id"/>
        </index>
        <index referenceId="ECCUBE_SYNC_HISTORY_ENTITY_TYPE_SOURCE_ID" indexType="btree">
            <column name="entity_type"/>
            <column name="source_id"/>
        </index>
        <index referenceId="ECCUBE_SYNC_HISTORY_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>
</schema>
