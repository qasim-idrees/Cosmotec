<script>
require([
    'jquery',
    'domReady!'
], function ($) {
    'use strict';

    var saveUrl = '<?= /* @noEscape */ $block->getSaveUrl() ?>',
        $root = $('#<?= /* @noEscape */ $blockId ?>');

    if ($root.data('cosmotecDocumentsInitialized')) {
        return;
    }
    $root.data('cosmotecDocumentsInitialized', true);

    function formKey() {
        return window.FORM_KEY || $('input[name="form_key"]').first().val();
    }

    $root.on('click', '#cosmotec-documents-save-btn', function (e) {
        e.preventDefault();

        var $form = $root.find('#cosmotec-documents-form'),
            formData = new FormData($form.get(0));

        formData.append('form_key', formKey());

        $.ajax({
            url: saveUrl,
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            dataType: 'json',
            showLoader: true
        }).done(function (response) {
            if (response.success) {
                window.location.reload();
            } else {
                alert(response.message || 'Could not save documents.');
            }
        }).fail(function () {
            alert('Could not save documents.');
        });
    });
});
</script>
